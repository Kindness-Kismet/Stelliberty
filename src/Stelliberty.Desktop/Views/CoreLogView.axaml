<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.CoreLogView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel"
             controls:InputDefocusBehavior.IsEnabled="True"
             Background="Transparent">
  <Grid x:Name="CoreLogPageRoot"
        RowDefinitions="Auto,*" RowSpacing="16"
        DataContext="{Binding CoreLogPage}"
        x:DataType="vm:CoreLogPageViewModel">

      <Border Classes="surface-header"
            Margin="8,0,25,0"
            AutomationProperties.AutomationId="CoreLogs.Toolbar">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="signal-dot" />
              <TextBlock Classes="list-eyebrow"
                         Text="{loc:Loc CoreLogs.Header.Eyebrow}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="list-count"
                         Text="{Binding FilteredLogCount}" />
              <TextBlock Classes="list-count-unit" Text="{loc:Loc CoreLogs.Count.Unit}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Border Classes="list-stat" MinWidth="92">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc CoreLogs.Stat.Total}" />
                <TextBlock Classes="list-stat-value" Text="{Binding TotalLogCount}" />
              </StackPanel>
            </Border>
            <Border Classes="list-stat" MinWidth="92">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc CoreLogs.Level.Warning}" />
                <TextBlock Classes="list-stat-value" Text="{Binding WarningLogCount}" />
              </StackPanel>
            </Border>
            <Border Classes="list-stat" MinWidth="92">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc CoreLogs.Level.Error}" />
                <TextBlock Classes="list-stat-value" Text="{Binding ErrorLogCount}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsAllLevelsSelected}"
                    AutomationProperties.AutomationId="CoreLogs.Filter.AllButton"
                    Command="{Binding ShowAllLevelsCommand}"
                    Content="{loc:Loc Common.Filter.All}" />
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsDebugLevelSelected}"
                    AutomationProperties.AutomationId="CoreLogs.Filter.DebugButton"
                    Command="{Binding ShowDebugLevelCommand}"
                    Content="{loc:Loc CoreLogs.Level.Debug}" />
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsInfoLevelSelected}"
                    AutomationProperties.AutomationId="CoreLogs.Filter.InfoButton"
                    Command="{Binding ShowInfoLevelCommand}"
                    Content="{loc:Loc CoreLogs.Level.Info}" />
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsWarningLevelSelected}"
                    AutomationProperties.AutomationId="CoreLogs.Filter.WarningButton"
                    Command="{Binding ShowWarningLevelCommand}"
                    Content="{loc:Loc CoreLogs.Level.Warning}" />
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsErrorLevelSelected}"
                    AutomationProperties.AutomationId="CoreLogs.Filter.ErrorButton"
                    Command="{Binding ShowErrorLevelCommand}"
                    Content="{loc:Loc CoreLogs.Level.Error}" />
          </StackPanel>

          <TextBox Grid.Column="1"
                   Classes="list-search"
                   AutomationProperties.AutomationId="CoreLogs.SearchBox"
                   PlaceholderText="{loc:Loc CoreLogs.Search.Placeholder}"
                   Text="{Binding SearchKeyword, Mode=TwoWay}"
                   MinWidth="220" MaxWidth="360"
                   HorizontalAlignment="Right">
            <TextBox.InnerLeftContent>
              <Border Padding="10,0,4,0">
                <iconPacks:PackIconMingCuteIcons Width="14" Height="14"
                                                   Kind="SearchLine"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
              </Border>
            </TextBox.InnerLeftContent>
          </TextBox>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="CoreLogs.TogglePauseButton"
                    Command="{Binding TogglePauseCommand}"
                    ToolTip.Tip="{Binding MonitoringToggleTooltip}">
              <iconPacks:PackIconMingCuteIcons Classes="icon pause-toggle-icon"
                                                Classes.paused="{Binding IsMonitoringPaused}"
                                                Width="15" Height="15" />
            </Button>
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="CoreLogs.ClearButton"
                    Command="{Binding ClearLogsCommand}"
                    ToolTip.Tip="{loc:Loc CoreLogs.Action.Clear}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="DeleteLine" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Border Classes="list-empty"
              IsVisible="{Binding IsEmptyVisible}">
        <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Panel HorizontalAlignment="Center">
            <Border Classes="list-empty-halo" />
            <iconPacks:PackIconMingCuteIcons Classes="list-empty-icon" Kind="FileLine" />
          </Panel>
          <StackPanel Spacing="7">
            <TextBlock Classes="list-empty-text" AutomationProperties.AutomationId="CoreLogs.EmptyText" Text="{Binding EmptyText}" />
            <TextBlock Classes="list-empty-hint" Text="{loc:Loc CoreLogs.Empty.Hint}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer AutomationProperties.AutomationId="CoreLogs.ListScroll"
                    IsVisible="{Binding !IsEmptyVisible}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl AutomationProperties.AutomationId="CoreLogs.List"
                      Margin="8,0,25,15"
                      ItemsSource="{Binding FilteredLogRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CoreLogRowViewModel">
              <Border Classes="surface-row"
                      Margin="0,0,0,10"
                      AutomationProperties.AutomationId="{Binding RowAutomationId}"
                      Tag="{Binding Payload}">
                <Grid ColumnDefinitions="Auto,80,74,*" MinHeight="68">
                  <Border Classes="list-color-bar"
                          Tag="{Binding LevelStyleClass}"
                          Width="4" Margin="10,13,0,13" CornerRadius="2"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1"
                             AutomationProperties.AutomationId="{Binding TimeAutomationId}"
                             Text="{Binding FormattedTime}"
                             FontFamily="Consolas"
                             Foreground="{DynamicResource AppTextTertiaryBrush}"
                             FontSize="12"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="2"
                          Classes="list-pill"
                          Tag="{Binding LevelStyleClass}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="{Binding LevelAutomationId}"
                               Text="{Binding LevelText}" />
                  </Border>
                  <TextBlock Grid.Column="3"
                             AutomationProperties.AutomationId="{Binding PayloadAutomationId}"
                             Text="{Binding Payload}"
                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                             FontSize="13"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"
                             MaxLines="2"
                             Margin="10,12,16,12"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
