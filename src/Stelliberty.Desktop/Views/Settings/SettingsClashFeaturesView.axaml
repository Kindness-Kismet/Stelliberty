<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.Settings.SettingsClashFeaturesView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
<!-- Clash 功能开关 -->
<StackPanel Spacing="10" IsVisible="{Binding Settings.IsClashFeaturesVisible}">
  <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupClashText}" />
  <Border Classes="surface-group">
    <StackPanel>
      <Button Classes="settings-row first"
              AutomationProperties.AutomationId="Settings.NetworkEntry"
              Command="{Binding Settings.ShowNetworkCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="RouteLine" />
          </Border>
          <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Settings.ClashNetworkText}" />
          <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row"
              AutomationProperties.AutomationId="Settings.PortControlEntry"
              Command="{Binding Settings.ShowPortControlCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="Settings6Line" />
          </Border>
          <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Settings.ClashPortControlText}" />
          <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row"
              AutomationProperties.AutomationId="Settings.SystemIntegrationEntry"
              Command="{Binding Settings.ShowSystemIntegrationCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="ComputerLine" />
          </Border>
          <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Settings.ClashSystemIntegrationText}" />
          <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row"
              AutomationProperties.AutomationId="Settings.DnsEntry"
              Command="{Binding Settings.ShowDnsCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="EarthLine" />
          </Border>
          <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Settings.ClashDnsText}" />
          <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row"
              AutomationProperties.AutomationId="Settings.PerformanceEntry"
              Command="{Binding Settings.ShowPerformanceCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="PerformanceLine" />
          </Border>
          <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Settings.ClashPerformanceText}" />
          <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row last"
              AutomationProperties.AutomationId="Settings.CoreLogEntry"
              Command="{Binding Settings.ShowCoreLogCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="TerminalBoxLine" />
          </Border>
          <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Settings.ClashCoreLogText}" />
          <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</StackPanel>
</UserControl>
