<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.Settings.SettingsRootView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
<!-- 设置首页：分组入口列表 -->
<StackPanel Spacing="10" IsVisible="{Binding Settings.IsRootVisible}">
  <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupPersonalizationText}" />
  <Border Classes="surface-group">
    <StackPanel>
      <Button Classes="settings-row first"
              AutomationProperties.AutomationId="Settings.ThemeEntry"
              Command="{Binding Settings.ShowThemeCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon settings-theme-icon"
                                              Kind="Palette3Line" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Classes="settings-row-title" Text="{Binding Settings.ThemeEntryTitle}" />
            <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.ThemeEntryDescription}" />
          </StackPanel>
          <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                            Classes="settings-chevron"
                                            Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row last"
              AutomationProperties.AutomationId="Settings.LanguageEntry"
              Command="{Binding Settings.ShowLanguageCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="Translate2Line" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Classes="settings-row-title" Text="{Binding Settings.LanguageEntryTitle}" />
            <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.LanguageEntryDescription}" />
          </StackPanel>
          <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                            Classes="settings-chevron"
                                            Kind="RightSmallLine" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>

  <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupClashText}" />
  <Border Classes="surface-group">
    <Button Classes="settings-row only"
            AutomationProperties.AutomationId="Settings.ClashFeaturesEntry"
            Command="{Binding Settings.ShowClashFeaturesCommand}">
      <Grid ColumnDefinitions="48,*,Auto">
        <Border Grid.Column="0" Classes="settings-icon-badge">
          <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                            Kind="SendPlaneLine" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock Classes="settings-row-title" Text="{Binding Settings.ClashFeaturesEntryTitle}" />
          <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.ClashFeaturesEntryDescription}" />
        </StackPanel>
        <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                          Classes="settings-chevron"
                                          Kind="RightSmallLine" />
      </Grid>
    </Button>
  </Border>

  <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupApplicationText}" />
  <Border Classes="surface-group">
    <StackPanel>
      <Button Classes="settings-row first"
              AutomationProperties.AutomationId="Settings.AppBehaviorEntry"
              Command="{Binding Settings.ShowAppBehaviorCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="ToggleLeftLine" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Classes="settings-row-title" Text="{Binding Settings.AppBehaviorEntryTitle}" />
            <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.AppBehaviorEntryDescription}" />
          </StackPanel>
          <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                            Classes="settings-chevron"
                                            Kind="RightSmallLine" />
        </Grid>
      </Button>
      <Border Classes="settings-row-divider" />
      <Button Classes="settings-row last"
              AutomationProperties.AutomationId="Settings.AboutEntry"
              Command="{Binding Settings.ShowAboutCommand}">
        <Grid ColumnDefinitions="48,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="InformationLine" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Classes="settings-row-title" Text="{Binding Settings.AboutEntryTitle}" />
            <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.AboutEntryDescription}" />
          </StackPanel>
          <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                            Classes="settings-chevron"
                                            Kind="RightSmallLine" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>

  <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupMaintenanceText}" />
  <Border Classes="surface-group">
    <Button Classes="settings-row only"
            AutomationProperties.AutomationId="Settings.DataEntry"
            Command="{Binding Settings.ShowDataManagementCommand}">
      <Grid ColumnDefinitions="48,*,Auto">
        <Border Grid.Column="0" Classes="settings-icon-badge">
          <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                            Kind="StorageLine" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock Classes="settings-row-title" Text="{Binding Settings.DataManagementEntryTitle}" />
          <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.DataManagementEntryDescription}" />
        </StackPanel>
        <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                          Classes="settings-chevron"
                                          Kind="RightSmallLine" />
      </Grid>
    </Button>
  </Border>
</StackPanel>
</UserControl>
