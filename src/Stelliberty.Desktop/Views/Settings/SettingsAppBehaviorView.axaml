<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.Settings.SettingsAppBehaviorView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
<!-- 应用行为 -->
<StackPanel Spacing="10" IsVisible="{Binding Settings.IsAppBehaviorVisible}">
  <TextBlock Classes="surface-group-title" Text="{Binding Settings.HeaderText}" />
  <Border Classes="surface-group">
    <StackPanel>
      <Border Classes="settings-inline-row">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Classes="settings-row-title" Text="{Binding AppBehavior.SilentStartText}" />
            <TextBlock Classes="settings-row-subtitle"
                       AutomationProperties.AutomationId="Settings.SilentStartDescriptionText"
                       Text="{Binding AppBehavior.SilentStartDescriptionText}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.AutomationId="Settings.SilentStartToggle"
                        IsChecked="{Binding AppBehavior.IsSilentStartEnabled, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Classes="settings-row-divider" />
      <Border Classes="settings-inline-row">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="settings-row-title" Text="{Binding AppBehavior.MinimizeToTrayText}" />
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.AutomationId="Settings.MinimizeToTrayToggle"
                        IsChecked="{Binding AppBehavior.IsMinimizeToTrayEnabled, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Classes="settings-row-divider" />
      <Border Classes="settings-inline-row">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Classes="settings-row-title" Text="{Binding AppBehavior.TrayDoubleClickText}" />
            <TextBlock Classes="settings-row-subtitle"
                       AutomationProperties.AutomationId="Settings.TrayDoubleClickDescriptionText"
                       Text="{Binding AppBehavior.TrayDoubleClickDescriptionText}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.AutomationId="Settings.TrayDoubleClickToggle"
                        IsChecked="{Binding AppBehavior.IsTrayDoubleClickEnabled, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Classes="settings-row-divider" />
      <Border Classes="settings-inline-row">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Classes="settings-row-title" Text="{Binding AppBehavior.LazyModeText}" />
            <TextBlock Classes="settings-row-subtitle"
                       AutomationProperties.AutomationId="Settings.LazyModeDescriptionText"
                       Text="{Binding AppBehavior.LazyModeDescriptionText}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.AutomationId="Settings.LazyModeToggle"
                        IsChecked="{Binding AppBehavior.IsLazyModeEnabled, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Classes="settings-row-divider" />
      <Border Classes="settings-inline-row">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="settings-row-title" Text="{Binding AppBehavior.StartupText}" />
          <ToggleSwitch Grid.Column="1"
                        AutomationProperties.AutomationId="Settings.AutoStartToggle"
                        IsChecked="{Binding AppBehavior.IsAutoStartEnabled, Mode=TwoWay}" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</StackPanel>
</UserControl>
