<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             x:Class="Stelliberty.Desktop.Views.Dialogs.AccentColorPickerView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Classes="dialog-title"
                 Text="{Binding Theme.AccentColorSectionTitle}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="dialog-close"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.CloseButton"
              Click="OnCancelClick">
        <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
      </Button>
    </Grid>

    <ColorView Grid.Row="1"
               x:Name="PART_ColorView"
               AutomationProperties.AutomationId="Settings.AccentColorDialog.ColorView"
               IsAlphaEnabled="False"
               IsAlphaVisible="False"
               IsAccentColorsVisible="False"
               IsColorPaletteVisible="False"
               Width="520"
               Height="360" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button Classes="dialog-secondary"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.CancelButton"
              Content="{Binding DialogCancelText}"
              Click="OnCancelClick" />
      <Button Classes="dialog-primary"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.ConfirmButton"
              Content="{Binding DialogConfirmText}"
              Click="OnConfirmClick" />
    </StackPanel>
  </Grid>
</UserControl>
